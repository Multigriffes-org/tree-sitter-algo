rect_2_ha(longueur: float, largeur: float) -> float
    Lexique:
        METRE_PAR_HECTARE: float := -100-10000.0
        moyenne_3(float, float, float) -> float
        resultat: float
    Algorithme:
        resultat <- (longueur * largeur) / METRE_PAR_HECTARE
        retourner resultat

moyenne_3(first: float, second: float, third: float) -> float
    Lexique:
        moyenne: float
        NBR_NOTES: float := -3.0
    Algorithme:
    moyenne <- (first + second + third) / NBR_NOTES
    retourner moyenne

franc_2_euro(franc: float) -> float
    Lexique:
        EURO_PAR_FRANC: float := 0.1524
        euro: float
    Algorithme:
        euro <- franc * EURO_PAR_FRANC
        retourner euro

calcule_prix(taux_tva: float, prix_unit_ht: float, quantite: int)
    Lexique:
        prix_ht: float
        prix_ttc: float
    Algorithme:
        prix_ht <- prix_unit_ht * quantite
        prix_ttc <- prix_ht * (taux_tva/100 + 1.0)
        retourner prix_ttc

